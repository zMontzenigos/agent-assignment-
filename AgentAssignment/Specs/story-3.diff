diff --git a/AgentAssignment/Sample/Dal/EnterpriseRepository.cs b/AgentAssignment/Sample/Dal/EnterpriseRepository.cs
index 0000011..0000020 100644
--- a/AgentAssignment/Sample/Dal/EnterpriseRepository.cs
+++ b/AgentAssignment/Sample/Dal/EnterpriseRepository.cs
@@ -7,4 +7,13 @@
     public Enterprise? GetById(Guid id) => _store.FirstOrDefault(e => e.Id == id);
+
+    public Enterprise? Update(Guid id, string? name, string? domain)
+    {
+        var i = _store.FindIndex(e => e.Id == id);
+        if (i < 0) return null;
+        _store[i] = _store[i] with { Name = name ?? _store[i].Name, Domain = domain ?? _store[i].Domain };
+        return _store[i];
+    }
 }
