diff --git a/AgentAssignment/Sample/Dal/UserRepository.cs b/AgentAssignment/Sample/Dal/UserRepository.cs
index 0000002..0000012 100644
--- a/AgentAssignment/Sample/Dal/UserRepository.cs
+++ b/AgentAssignment/Sample/Dal/UserRepository.cs
@@ -11,4 +11,13 @@
     public IReadOnlyList<User> GetAll() => _store.AsReadOnly();
+
+    public User? GetById(Guid id) => _store.FirstOrDefault(u => u.Id == id);
+
+    public User? Update(Guid id, string? name, string? email)
+    {
+        var i = _store.FindIndex(u => u.Id == id);
+        if (i < 0) return null;
+        _store[i] = _store[i] with { Name = name ?? _store[i].Name, Email = email ?? _store[i].Email };
+        return _store[i];
+    }
 }
